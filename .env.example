# 复制为 .env 后按需修改。所有变量说明见 README.md「环境变量」一节。

# PostgreSQL 连接串（本地可用 docker compose -f docker-compose.dev.yml up -d 启动）
DATABASE_URL=postgresql://eduverse:eduverse@localhost:5432/eduverse

# Payload 加密密钥：至少 32 位随机字符串。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# 站点对外访问地址（用于 canonical、sitemap、Open Graph），不带末尾斜杠
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 部署在单层可信反向代理（Nginx）之后时设为 true：留资限频取 X-Forwarded-For 的最后一个地址（没有时取 X-Real-IP）识别访客 IP。
# Nginx 需配置：
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Real-IP $remote_addr;
# 直接对外暴露时保持 false（否则访客可伪造请求头绕过按 IP 限频），此时只有全站兜底限流与手机号限频，生产环境会打印一次警告。
TRUST_PROXY=false

# 生产环境是否开放 /styleguide 设计规范页（开发环境始终开放）
ENABLE_STYLEGUIDE=false

# 关闭 Next.js 匿名遥测（数据发往境外）
NEXT_TELEMETRY_DISABLED=1
