# EduVerse 生产环境配置示例（docker compose 使用）。
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production          # 含数据库密码与密钥，只允许部署用户读取
#   docker compose --env-file deploy/.env.production up -d --build
#
# deploy/.env.production 已被 git 忽略（deploy/.gitignore），不要提交；本示例文件不含任何真实值。
# 放在 deploy/ 而不是项目根目录：根目录的 .env.production 会被本地 `pnpm build` / `pnpm start` 自动加载，
# 开发机上会误连生产配置。
#
# 每个变量的作用、默认值与是否必填见注释；“构建时”表示写入镜像，修改后需要重新构建（--build）。
# 值里含 $、#、空格或引号时用单引号包住整个值（如 POSTGRES_PASSWORD='a$b#c'）：不加引号时 compose 会把 $xxx 当作变量展开、
# 把“ #”之后当作注释，值被悄悄截短。openssl rand -hex 生成的十六进制串不需要引号。

# ───────────────────────── 站点 ─────────────────────────

# 【必填，构建时】站点对外访问地址：协议 + 域名，不带末尾斜杠。用于 canonical、sitemap、Open Graph、
# 群机器人推送里的后台链接。NEXT_PUBLIC_* 在构建时写入产物，换域名需重新构建镜像。
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ───────────────────────── 密钥 ─────────────────────────

# 【必填】Payload 加密密钥（登录会话、密码重置令牌）：至少 32 个字符的随机串。
# 生成：openssl rand -hex 32 。上线后不要更换，否则所有后台账号需要重新登录。
PAYLOAD_SECRET=

# ───────────────────────── 数据库（compose 内的 PostgreSQL 16） ─────────────────────────

# 【必填】数据库密码：首次启动时用于初始化数据库，之后修改此值不会改动已有数据库的密码
# （需要在数据库里 ALTER USER 后再改这里）。生成：openssl rand -hex 24 。可以包含特殊字符（入口脚本会做 URL 编码；按上面的说明加单引号）。
POSTGRES_PASSWORD=

# 数据库用户名与库名，默认 eduverse。同样只在首次初始化时生效。
POSTGRES_USER=eduverse
POSTGRES_DB=eduverse

# 使用外部（非 compose 内）PostgreSQL 时填写完整连接串，优先于上面的 POSTGRES_*：
#   DATABASE_URL=postgresql://用户:密码@主机:5432/库名
# 留空则连接 compose 内的 db 服务。注意：外部数据库时 compose 仍会启动 db 服务，可用
# `docker compose up -d app --no-deps` 只启动 app。
# deploy/backup.sh 与 deploy/restore.sh 只支持 compose 内的 db 服务：填写本项后两个脚本拒绝执行，
# 外部数据库请用其自身的备份 / 恢复方案（如云数据库快照）。
DATABASE_URL=

# ───────────────────────── 反向代理与访问 ─────────────────────────

# 是否信任反向代理传来的 X-Forwarded-For / X-Real-IP（留资与阅读量按访客 IP 限频）。默认 true：
# 按本项目的部署方式，app 只监听 127.0.0.1，前面有且只有一层 nginx（deploy/nginx.conf.example）。
# 如果不经 nginx、把端口直接暴露到公网，必须改为 false（否则访客可伪造请求头绕过按 IP 限频）。
TRUST_PROXY=true

# app 端口在宿主机上监听的地址与端口，默认 127.0.0.1:3000（nginx 的 upstream 指向这里）。
# 不要改成 0.0.0.0，除非前面另有防火墙且 TRUST_PROXY=false。
APP_BIND=127.0.0.1
APP_PORT=3000

# 生产环境是否开放 /styleguide 设计规范页，默认 false。
ENABLE_STYLEGUIDE=false

# 容器启动时是否先执行数据库迁移（payload migrate），默认 true。迁移失败时服务不会启动。
RUN_MIGRATIONS=true

# 容器启动时是否预渲染页面，默认 true：镜像构建时不连数据库，启动后连上数据库再生成首页、课程详情等静态页，
# 之后按 ISR 定时 / 后台保存时更新（与 pnpm build 行为一致）。内容越多启动越慢（几秒到一两分钟，期间 nginx 返回 502）；
# 预渲染失败只告警并退回按需渲染。设为 false 时所有页面在访问时渲染：启动最快，每次访问多消耗一些 CPU。
PRERENDER_ON_START=true

# 容器时区（日志时间、PostgreSQL 初始化时的默认时区）。页面上的日期始终按北京时间显示，与此无关。
TZ=Asia/Shanghai

# ───────────────────────── 镜像与构建（国内服务器可改为镜像源） ─────────────────────────

# 【构建时】Node.js 基础镜像，默认官方 node:22-bookworm-slim。Docker Hub 访问不稳定时改为可用的镜像源，
# 如 <镜像源域名>/library/node:22-bookworm-slim（必须是 Node 22 LTS、Debian bookworm 版本）。
NODE_IMAGE=node:22-bookworm-slim

# PostgreSQL 镜像，默认官方 postgres:16；国内可改为镜像源。不要跨大版本更换（16 → 17 需要 pg_dump 迁移数据）。
POSTGRES_IMAGE=postgres:16

# 【构建时】npm 源（pnpm 与 corepack 共用），默认官方；国内可用 https://registry.npmmirror.com/
NPM_REGISTRY=https://registry.npmjs.org/

# 【构建时，可选】公司网络对 HTTPS 做中间人代理（下载依赖报 SELF_SIGNED_CERT_IN_CHAIN）时，指向需要额外信任的
# 根证书文件（PEM）。只在下载依赖的步骤挂载，不会进入镜像。留空表示不需要。
BUILD_EXTRA_CA_FILE=

# 构建出的 app 镜像名。升级前可以给当前镜像打个标签留作回退（见 README 运维 · 升级）。
APP_IMAGE=eduverse-app:latest

# ───────────────────────── 备份（deploy/backup.sh 读取） ─────────────────────────

# 备份目录（宿主机绝对路径，不要放在项目目录里：git clean 会删掉）与保留天数，默认 /var/backups/eduverse、7 天。
# 备份含线索个人信息，脚本会把目录权限设为 700；建议再定期同步到另一台机器或对象存储。
BACKUP_DIR=/var/backups/eduverse
BACKUP_KEEP_DAYS=7
